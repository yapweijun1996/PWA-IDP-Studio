{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IDP Studio Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "document_type", "status", "extraction", "evidence", "validation", "model", "audit"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "document_id": { "type": "string" },
    "document_type": { "enum": ["purchase_invoice", "sales_order", "purchase_order", "bank_receipt", "credit_note", "payment_document", "delivery_order", "receipt", "other"] },
    "status": {
      "description": "Approved is reserved for explicit human review. AI extraction produces only ready or review_required; model-supplied status is ignored.",
      "enum": ["processing", "review_required", "ready", "approved", "failed"]
    },
    "extraction": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "line_items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "quantity": { "type": "number" },
              "unit_price": { "type": "number" },
              "amount": { "type": "number" }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["page", "bbox", "confidence"],
        "additionalProperties": false,
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "bbox": {
            "anyOf": [
              { "type": "null" },
              { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0, "maximum": 1 } }
            ]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_valid", "totals_match", "missing_required", "low_confidence", "standards_issues", "needs_review"],
      "properties": {
        "schema_valid": { "type": "boolean" },
        "totals_match": { "type": ["boolean", "null"] },
        "missing_required": { "type": "array", "items": { "type": "string" } },
        "low_confidence": { "type": "array", "items": { "type": "string" } },
        "standards_issues": { "type": "array", "items": { "type": "string" } },
        "needs_review": { "type": "boolean" }
      }
    },
    "model": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model"],
          "properties": { "provider": { "type": "string" }, "model": { "type": "string" } }
        }
      ]
    },
    "audit": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "action"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "action": { "enum": ["extracted", "field_edited", "approved"] },
          "field": { "type": "string" },
          "from": true,
          "to": true
        }
      }
    }
  }
}
